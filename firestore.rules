rules_version = '2';
// Reglas de seguridad de Firestore para BIOCOGNIA (QUAESTIA, SORTIVIA y DEAba Digital).
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
// - Cada participante (identificación anónima) solo puede crear sus propios registros, leerlos y borrarlos.
// - Nadie puede modificar un registro ya enviado.
// - Solo las cuentas listadas en esAdmin() pueden leer todos los datos (paneles del profesor).
// - SORTIVIA: cada grupo solo lee y edita su propio documento, y solo los campos y cambios de estado permitidos;
//   los puntos, los números y el sorteo los escribe únicamente el panel del profesor. Las claves solo las lee el profesor.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      // Identificadores de las cuentas del equipo investigador (los muestra admin.html al entrar).
      return request.auth != null && request.auth.uid in ['cMZwT1gAQHa5EmohnmYV9YmY4XT2'];
    }
    function propio() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }
    function creacionValida(campos) {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.creado == request.time
        && request.resource.data.keys().hasOnly(campos)
        && request.resource.data.app == 'quaestia'
        && request.resource.data.grupo is string
        && request.resource.data.grupo.size() <= 24;
    }

    match /intentos/{id} {
      allow create: if creacionValida(['uid', 'creado', 'app', 'app_version', 'grupo', 'modo', 'fecha', 'semana_curso', 'n_intento',
                                        'nota', 'bruto', 'max', 'duracion_s', 'lang', 'config', 'items'])
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 200;
      allow read, delete: if esAdmin() || propio();
      allow update: if false;
    }

    match /cortas/{id} {
      allow create: if creacionValida(['uid', 'creado', 'app', 'app_version', 'grupo', 'id', 'autoeval', 'fecha', 'semana_curso', 'longitud'])
                    && request.resource.data.autoeval in ['bien', 'parcial', 'mal'];
      allow read, delete: if esAdmin() || propio();
      allow update: if false;
    }

    // ---------- SORTIVIA ----------
    // Profesores autorizados por el administrador (documento profesores/{uid} con activo == true).
    function esProfesor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profesores/$(request.auth.uid))
        && get(/databases/$(database)/documents/profesores/$(request.auth.uid)).data.activo == true;
    }
    function esDocente() { return esAdmin() || esProfesor(); }

    match /profesores/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if esAdmin();
    }

    // Actividades subidas desde el panel. El contenido es público (lo necesitan los grupos);
    // las claves están aparte, en /claves.
    match /actividades/{aid} {
      allow read: if request.auth != null;
      allow create: if esAdmin()
                    || (esProfesor() && request.resource.data.autor == request.auth.uid && request.resource.data.estado == 'borrador');
      allow update: if esAdmin()
                    || (esProfesor() && resource.data.autor == request.auth.uid
                        && resource.data.estado in ['borrador', 'propuesta']
                        && request.resource.data.autor == request.auth.uid
                        && request.resource.data.estado in ['borrador', 'propuesta']);
      allow delete: if esAdmin() || (esProfesor() && resource.data.autor == request.auth.uid && resource.data.estado != 'publicada');
    }

    // Claves (puntos y reglas): solo el profesorado autorizado. Un profesor solo puede escribir la de su propia actividad no publicada.
    match /claves/{aid} {
      allow read: if esDocente();
      allow write: if esAdmin()
                   || (esProfesor()
                       && get(/databases/$(database)/documents/actividades/$(aid)).data.autor == request.auth.uid
                       && get(/databases/$(database)/documents/actividades/$(aid)).data.estado != 'publicada');
    }

    match /sesiones/{sid} {
      allow read: if request.auth != null;
      allow create: if esAdmin() || (esProfesor() && request.resource.data.propietario == request.auth.uid);
      allow update, delete: if esAdmin() || (esProfesor() && resource.data.propietario == request.auth.uid);

      match /grupos/{gid} {
        function camposGrupo() { return ['nombre', 'ronda', 'estado', 'eleccion', 'justif', 'coste', 'actualizado', 'elegidos']; }
        function sesion() { return get(/databases/$(database)/documents/sesiones/$(sid)).data; }
        function sesionAbierta() { return sesion().estado == 'abierta'; }
        function esDueno() { return esProfesor() && sesion().propietario == request.auth.uid; }
        function esGrupo() { return request.auth != null && request.auth.uid == gid; }
        function antes() { return resource.data; }
        function despues() { return request.resource.data; }

        allow read: if esAdmin() || esDueno() || esGrupo();
        allow create: if esGrupo() && sesionAbierta()
                      && despues().keys().hasOnly(camposGrupo())
                      && despues().estado == 'editando' && despues().ronda == 1
                      && despues().nombre is string && despues().nombre.size() <= 40;
        // El grupo solo puede: editar y enviar; elegir números y pedir el sorteo; pasar a la ronda siguiente tras fallar.
        // Los puntos, los números y el sorteo los escribe el profesor de la sesión (o el administrador).
        allow update: if esAdmin() || esDueno() || (esGrupo() && sesionAbierta()
                      && despues().diff(antes()).affectedKeys().hasOnly(camposGrupo())
                      && despues().nombre is string && despues().nombre.size() <= 40
                      && despues().ronda >= antes().ronda && despues().ronda <= 5
                      && ( (antes().estado == 'editando' && despues().estado in ['editando', 'enviado'] && despues().ronda == antes().ronda)
                        || (antes().estado == 'puntuado' && despues().estado in ['puntuado', 'sorteo_pedido'] && despues().ronda == antes().ronda)
                        || (antes().estado == 'fallado' && despues().estado == 'editando' && despues().ronda == antes().ronda + 1)
                        || (antes().estado == despues().estado && despues().ronda == antes().ronda) ));
        allow delete: if esAdmin() || esDueno();
      }
    }

    // ---------- DEAba Digital ----------
    // Guías del profesor (respuestas esperadas): solo el profesorado autorizado; solo el administrador las sube.
    // Actividades creadas desde el panel: el contenido lo leen los grupos; el profesorado crea borradores y los propone.
    match /deaba_actividades/{aid} {
      allow read: if request.auth != null;
      allow create: if esAdmin()
                    || (esProfesor() && request.resource.data.autor == request.auth.uid && request.resource.data.estado == 'borrador');
      allow update: if esAdmin()
                    || (esProfesor() && resource.data.autor == request.auth.uid
                        && resource.data.estado in ['borrador', 'propuesta']
                        && request.resource.data.autor == request.auth.uid
                        && request.resource.data.estado in ['borrador', 'propuesta']);
      allow delete: if esAdmin() || (esProfesor() && resource.data.autor == request.auth.uid && resource.data.estado != 'publicada');
    }
    function deabaActividad(aid) { return get(/databases/$(database)/documents/deaba_actividades/$(aid)).data; }
    // Guías del profesor (respuestas esperadas): solo el profesorado. El administrador sube cualquiera;
    // cada profesor, la de su propia actividad mientras no esté publicada.
    match /deaba_guias/{aid} {
      allow read: if esDocente();
      allow write: if esAdmin()
                   || (esProfesor()
                       && exists(/databases/$(database)/documents/deaba_actividades/$(aid))
                       && deabaActividad(aid).autor == request.auth.uid
                       && deabaActividad(aid).estado != 'publicada');
    }
    match /deaba_sesiones/{sid} {
      allow read: if request.auth != null;
      allow create: if esAdmin() || (esProfesor() && request.resource.data.propietario == request.auth.uid);
      allow update, delete: if esAdmin() || (esProfesor() && resource.data.propietario == request.auth.uid);

      match /grupos/{gid} {
        function dsesion() { return get(/databases/$(database)/documents/deaba_sesiones/$(sid)).data; }
        function dabierta() { return dsesion().estado == 'abierta'; }
        function ddueno() { return esProfesor() && dsesion().propietario == request.auth.uid; }
        function dgrupo() { return request.auth != null && request.auth.uid == gid; }
        // Cada grupo solo ve y edita su propio documento. La nota y los avisos los escribe el profesor.
        allow read: if esAdmin() || ddueno() || dgrupo();
        allow create: if dgrupo() && dabierta()
                      && request.resource.data.keys().hasOnly(['nombre', 'estado', 'resp', 'actualizado'])
                      && request.resource.data.estado == 'editando'
                      && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40;
        allow update: if esAdmin() || ddueno() || (dgrupo() && dabierta()
                      && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
                      && ( (resource.data.estado == 'editando'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'estado', 'resp', 'actualizado'])
                            && request.resource.data.estado in ['editando', 'enviado'])
                        || (resource.data.estado == 'enviado'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'revision', 'actualizado'])) ));
        allow delete: if esAdmin() || ddueno();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
